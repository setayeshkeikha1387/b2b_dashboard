DJANGO_SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Defaults to a local SQLite file if unset — no database setup needed to
# try the MVP. For Postgres (recommended in production):
# DATABASE_URL=postgres://dashboard_user:dashboard_password@db:5432/dashboard_db
DATABASE_URL=sqlite:///db.sqlite3

# Email — defaults to the console backend (prints emails to the terminal)
# so notifications work out of the box with zero setup. Switch to SMTP
# for real delivery:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=B2B Dashboard <noreply@example.com>

# Used to build absolute links inside notification emails.
SITE_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
